# Shared SimpleAPI URL (no trailing slash)
# For testing against the SwaggerHub mock: https://virtserver.swaggerhub.com/MarketplaceSimpleAPI/MarketplaceSimpleAPI/1.0.0
LCMP_BASE_URL=https://marketplace.logicom.net/SimpleAPI/SimpleAPIService.svc/rest

# Country marketplaces to enable (codes: CYMA, GR, ENET, RO, IT, SA, JO, LB, AE, QA, KW, OM, BH, MA)
LCMP_MARKETPLACES=CYMA,GR,ENET,RO,IT,SA,JO,LB,AE,QA,KW,OM,BH,MA

# One read-only API user per marketplace (users without MFA; MFA users cannot use the API)
LCMP_CYMA_USERNAME=
LCMP_CYMA_PASSWORD=
LCMP_GR_USERNAME=
LCMP_GR_PASSWORD=
LCMP_ENET_USERNAME=
LCMP_ENET_PASSWORD=
LCMP_RO_USERNAME=
LCMP_RO_PASSWORD=
LCMP_IT_USERNAME=
LCMP_IT_PASSWORD=
LCMP_SA_USERNAME=
LCMP_SA_PASSWORD=
LCMP_JO_USERNAME=
LCMP_JO_PASSWORD=
LCMP_LB_USERNAME=
LCMP_LB_PASSWORD=
LCMP_AE_USERNAME=
LCMP_AE_PASSWORD=
LCMP_QA_USERNAME=
LCMP_QA_PASSWORD=
LCMP_KW_USERNAME=
LCMP_KW_PASSWORD=
LCMP_OM_USERNAME=
LCMP_OM_PASSWORD=
LCMP_BH_USERNAME=
LCMP_BH_PASSWORD=
LCMP_MA_USERNAME=
LCMP_MA_PASSWORD=

# Single-marketplace alternative (used when LCMP_MARKETPLACES is empty)
# LCMP_MARKETPLACE=CYMA
# LCMP_USERNAME=
# LCMP_PASSWORD=

# Optional default request timeout in milliseconds (default 30000; reports always use 300000)
LCMP_TIMEOUT_MS=30000

# Optional: API requests in flight per marketplace user (default 3)
# LCMP_MAX_CONCURRENCY=3

# --- Hosted HTTP mode (Azure / Copilot Studio) ---
# MCP_TRANSPORT=http          # or start with --http
# HOST=0.0.0.0                # default 127.0.0.1
# PORT=3000
# Entra ID app registration that protects the API
# ENTRA_TENANT_ID=
# ENTRA_AUDIENCE=api://<client-id>,<client-id>
# ENTRA_REQUIRED_ROLE=LCMP.Read   # app role users must be assigned; "" allows any user in the tenant
# Local testing only (refused unless HOST is loopback):
# MCP_AUTH=none
