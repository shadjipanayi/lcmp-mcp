{
  "name": "lcmp-mcp",
  "version": "0.3.0",
  "description": "Read-only MCP server for the LCMP Marketplace SimpleAPI",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node --env-file-if-exists=.env dist/index.js",
    "smoke": "node scripts/smoke-test.mjs",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.12.0",
    "jose": "^6.2.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "bin": {
    "lcmp-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.9"
  },
  "private": true
}
